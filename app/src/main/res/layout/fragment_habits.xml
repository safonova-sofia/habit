<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Привычки"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"
        android:gravity="center"/>

    <!-- Кнопка обновления списка привычек -->
    <Button
        android:id="@+id/buttonRefreshHabits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Обновить список привычек"
        android:layout_gravity="center"/>

    <!-- RecyclerView для отображения привычек -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/habitsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Кнопка для создания новой привычки -->
    <Button
        android:id="@+id/createHabitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Создать привычку"
        android:layout_marginTop="16dp"/>

</LinearLayout>
